<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Logging.fs"/>
        <Compile Include="Serialization.fs"/>
        <Compile Include="storage\Constants.fs"/>
        <Compile Include="storage\JsonStorage.fs"/>
        <Compile Include="ces\TaskResultBuilder.fs"/>
        <Compile Include="ces\ResultBuilder.fs"/>
        <Compile Include="ces\OptionBuilder.fs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bolt.Models\Bolt.Models.fsproj"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="FSharp.SystemTextJson">
            <HintPath>..\..\..\.nuget\packages\fsharp.systemtextjson\1.4.36\lib\netstandard2.0\FSharp.SystemTextJson.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
