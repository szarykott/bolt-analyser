meta {
  name: SendMagicLink
  type: http
  seq: 2
}

post {
  url: https://driver.live.boltsvc.net/driver/sendMagicLink?version={{VERSION}}
  body: formUrlEncoded
  auth: inherit
}

params:query {
  version: {{VERSION}}
}

body:form-urlencoded {
  email: radoslaw.edward.kot@gmail.com
  device_uid: {{DEVICE_ID}}
  device_name: {{DEVICE_NAME}}
  device_os_version: {{DEVICE_OS_VERSION}}
}

settings {
  encodeUrl: true
  timeout: 0
}
