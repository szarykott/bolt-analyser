meta {
  name: GetActivityHours
  type: http
  seq: 4
}

get {
  url: https://europe-company.taxify.eu/orderDriver/getActivityHours?version={{VERSION}}&country={{COUNTRY}}&language={{LANGUAGE}}&deviceType={{DEVICE_TYPE}}&deviceId={{DEVICE_ID}}&device_os_version={{DEVICE_OS_VERSION}}&group_by=week
  body: none
  auth: inherit
}

params:query {
  version: {{VERSION}}
  country: {{COUNTRY}}
  language: {{LANGUAGE}}
  deviceType: {{DEVICE_TYPE}}
  deviceId: {{DEVICE_ID}}
  device_os_version: {{DEVICE_OS_VERSION}}
  group_by: week
}

headers {
  ~Content-Type: application/json
}
